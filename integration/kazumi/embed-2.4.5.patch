diff --git a/test/anon_community_danmaku_test.dart b/test/anon_community_danmaku_test.dart
new file mode 100644
index 0000000..b960d0e
--- /dev/null
+++ b/test/anon_community_danmaku_test.dart
@@ -0,0 +1,45 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:kazumi/request/apis/community_danmaku.dart';
+import 'package:kazumi/utils/bangumi_mirror_credentials.dart';
+
+void main() {
+  test(
+    'selects the actual episode ID even with specials and nonconsecutive IDs',
+    () {
+      final episodes = [
+        {'episodeTitle': '特典', 'episodeNumber': '1', 'episodeId': 5},
+        {'episodeTitle': '第1话 羽丘的怪女孩', 'episodeNumber': '1', 'episodeId': 84},
+        {'episodeTitle': 'EP.2', 'episodeId': 190},
+      ];
+      expect(CommunityDanmaku.episodeId(episodes, 1), 84);
+      expect(CommunityDanmaku.episodeId(episodes, 2), 190);
+      expect(CommunityDanmaku.episodeId(episodes, 3), isNull);
+      expect(
+        CommunityDanmaku.episodeId([
+          ...episodes,
+          {'episodeTitle': '第1话', 'episodeId': 234},
+        ], 1),
+        isNull,
+      );
+    },
+  );
+
+  test('distinguishes the signed mirror routes from public catalogues', () {
+    expect(
+      isProtectedBangumiMirrorRequest('POST', '/v0/search/subjects'),
+      isTrue,
+    );
+    expect(
+      isProtectedBangumiMirrorRequest('GET', '/p1/episodes/42/comments'),
+      isTrue,
+    );
+    expect(
+      isProtectedBangumiMirrorRequest('GET', '/p1/characters/7/comments'),
+      isTrue,
+    );
+    expect(
+      isProtectedBangumiMirrorRequest('GET', '/p1/trending/subjects'),
+      isFalse,
+    );
+  });
+}
