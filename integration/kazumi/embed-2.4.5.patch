diff --git a/lib/request/apis/community_danmaku.dart b/lib/request/apis/community_danmaku.dart
new file mode 100644
index 0000000..a0d2708
--- /dev/null
+++ b/lib/request/apis/community_danmaku.dart
@@ -0,0 +1,127 @@
+import 'package:kazumi/modules/danmaku/danmaku_episode_response.dart';
+import 'package:kazumi/modules/danmaku/danmaku_search_response.dart';
+import 'package:kazumi/request/core/dio_factory.dart';
+
+/// Read-only provider used by the host when a signed DanDanPlay account was
+/// not supplied at build time. Its episode IDs must be read from its catalogue.
+class CommunityDanmaku {
+  static const origin = 'https://danmaku-api.152468.xyz';
+  static final _cache = <int, List<Map<String, dynamic>>>{};
+  static final _titleCache = <String, int>{};
+
+  static Future<DanmakuSearchResponse> search(String name) async {
+    final response = await DioFactory.apiDio.get(
+      '$origin/api/v2/search/anime',
+      queryParameters: {'keyword': name},
+    );
+    final data = response.data as Map<String, dynamic>;
+    final rows = (data['animes'] as List?) ?? const [];
+    return DanmakuSearchResponse(
+      animes: [
+        for (final item in rows.whereType<Map<String, dynamic>>())
+          if (item['animeId'] is int && item['animeTitle'] is String)
+            DanmakuSearchAnime.fromJson(item),
+      ],
+      hasMore: data['hasMore'] == true,
+    );
+  }
+
+  static String _normalize(String name) => name.toLowerCase().replaceAll(
+    RegExp(r'''[\s!！?？.,，。:：・·\x60'"’“”「」『』()（）-]+'''),
+    '',
+  );
+
+  static Future<int> matchTitle(List<String> names) async {
+    for (final name in names.map((name) => name.trim()).toSet()) {
+      final key = _normalize(name);
+      if (key.isEmpty) continue;
+      final cached = _titleCache[key];
+      if (cached != null) return cached;
+      final results = await search(name);
+      final exact = results.animes
+          .where((item) => _normalize(item.animeTitle) == key)
+          .map((item) => item.animeId)
+          .toSet();
+      if (exact.length == 1 && !results.hasMore) {
+        if (_titleCache.length >= 64)
+          _titleCache.remove(_titleCache.keys.first);
+        return _titleCache[key] = exact.single;
+      }
+    }
+    return 0;
+  }
+
+  static Future<List<Map<String, dynamic>>> _episodes(int showId) async {
+    final cached = _cache[showId];
+    if (cached != null) return cached;
+    final response = await DioFactory.apiDio.get(
+      '$origin/api/v2/bangumi/$showId',
+    );
+    final detail = response.data['bangumi'];
+    if (detail is! Map ||
+        detail['animeId'] != showId ||
+        detail['episodes'] is! List) {
+      throw const FormatException('弹幕服务返回的剧集资料有误');
+    }
+    final entries = (detail['episodes'] as List)
+        .whereType<Map<String, dynamic>>()
+        .where(
+          (row) => row['episodeId'] is int && (row['episodeId'] as int) > 0,
+        )
+        .toList();
+    if (_cache.length >= 12) _cache.remove(_cache.keys.first);
+    return _cache[showId] = entries;
+  }
+
+  static Future<DanmakuEpisodeResponse> catalogue(int showId) async {
+    final rows = await _episodes(showId);
+    return DanmakuEpisodeResponse(
+      bangumiId: showId,
+      episodes: [
+        for (final row in rows)
+          DanmakuEpisode(
+            episodeId: row['episodeId'],
+            episodeTitle: (row['episodeTitle'] ?? row['episodeNumber'] ?? '')
+                .toString(),
+          ),
+      ],
+      errorCode: 0,
+      success: true,
+      errorMessage: '',
+    );
+  }
+
+  static final _episodeLabel = RegExp(
+    r'(?:第\s*(\d+)\s*[话話集回]|\b(?:EP(?:ISODE)?|E)\.?\s*(\d+)\b)',
+    caseSensitive: false,
+  );
+  static final _special = RegExp(
+    r'(?:\b(?:SP|OVA|OAD|PV|SPECIAL|EXTRA)\d*\b|番外|特典|预告|預告)',
+    caseSensitive: false,
+  );
+
+  static int? episodeId(Iterable<Map<String, dynamic>> rows, int number) {
+    final ids = <int>{};
+    for (final row in rows) {
+      final title = (row['episodeTitle'] ?? '').toString();
+      if (_special.hasMatch(title)) continue;
+      final label = _episodeLabel.firstMatch(title);
+      final labelNumber = label == null
+          ? int.tryParse(title.trim())
+          : int.tryParse(label.group(1) ?? label.group(2) ?? '');
+      final explicit = row['episodeNumber']?.toString().trim();
+      final actual = explicit == null || explicit.isEmpty
+          ? labelNumber
+          : num.tryParse(explicit);
+      if (actual == number &&
+          (labelNumber == null || labelNumber == number) &&
+          row['episodeId'] is int) {
+        ids.add(row['episodeId'] as int);
+      }
+    }
+    return ids.length == 1 ? ids.single : null;
+  }
+
+  static Future<int?> findEpisode(int showId, int number) async =>
+      episodeId(await _episodes(showId), number);
+}
