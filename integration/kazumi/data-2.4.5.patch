diff --git a/lib/services/storage/anon_legacy_import.dart b/lib/services/storage/anon_legacy_import.dart
new file mode 100644
--- /dev/null
+++ b/lib/services/storage/anon_legacy_import.dart
@@ -0,0 +1,107 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter/services.dart';
+import 'package:kazumi/modules/bangumi/bangumi_item.dart';
+import 'package:kazumi/modules/collect/collect_type.dart';
+import 'package:kazumi/plugins/plugins.dart';
+import 'package:kazumi/plugins/plugins_controller.dart';
+import 'package:kazumi/repositories/collect_crud_repository.dart';
+import 'package:kazumi/services/logging/logger.dart';
+import 'package:kazumi/services/plugin/plugin_import_parser.dart';
+import 'package:kazumi/services/storage/storage.dart';
+import 'package:path_provider/path_provider.dart';
+
+class AnonLegacyImport {
+  static const _legacy = MethodChannel('com.shengjian.player/legacy-anime');
+
+  // Android path_provider's application support directory is Context.getFilesDir().
+  // Commit the marker after all writes. Existing rules and collections win on retry.
+  static Future<void> _once(
+    String name,
+    Future<bool> Function(Directory) migrate,
+  ) async {
+    if (!Platform.isAndroid) return;
+    try {
+      final directory = await getApplicationSupportDirectory();
+      final marker = File('${directory.path}/anon-import-v1-$name.done');
+      if (await marker.exists()) return;
+      if (await migrate(directory)) await marker.create();
+    } catch (error, stack) {
+      KazumiLogger().w('ANON: $name migration will be retried',
+          error: error, stackTrace: stack);
+    }
+  }
+
+  static List<Plugin> pendingRules(List<dynamic> rows, Set<String> existing) {
+    final definitions = [
+      for (final row in rows)
+        if (row is Map && row['enabled'] != false && row['rule'] is Map)
+          row['rule'],
+    ];
+    final parsed = PluginImportParser.parse(jsonEncode(definitions));
+    return parsed.plugins
+        .where((rule) => !existing.contains(pluginNameKey(rule.name)))
+        .toList();
+  }
+
+  static Future<void> importRules(PluginsController plugins) =>
+      _once('rules', (directory) async {
+        final file = File('${directory.path}/anime-sources.json');
+        if (!await file.exists()) return false;
+        final rows = jsonDecode(await file.readAsString()) as List;
+        if (rows.isEmpty) return false;
+        final existing = plugins.pluginList.map((p) => pluginNameKey(p.name)).toSet();
+        final pending = pendingRules(rows, existing);
+        if (pending.isNotEmpty) await plugins.updatePlugins(pending);
+        return true;
+      });
+
+  static Map<int, (BangumiItem, CollectType)> favorites(List<dynamic> rows) {
+    // Old ANON writes the newest row first and can have several sources per work.
+    final works = <int, (BangumiItem, CollectType)>{};
+    for (final row in rows.whereType<Map>()) {
+      final id = row['bangumi'];
+      final title = row['title'];
+      if (id is! int || id <= 0 || works.containsKey(id) ||
+          title is! String || title.trim().isEmpty) continue;
+      final status = switch (row['status']) {
+        'watching' => CollectType.watching,
+        'completed' => CollectType.watched,
+        'paused' => CollectType.onHold,
+        'dropped' => CollectType.abandoned,
+        _ => CollectType.planToWatch,
+      };
+      final cover = row['cover'] is String ? row['cover'] as String : '';
+      final work = BangumiItem.fromJson({
+        'id': id,
+        'name': title.trim(),
+        'rating': <String, dynamic>{},
+        'images': {for (final size in ['large', 'common', 'medium', 'small', 'grid']) size: cover},
+      });
+      works[id] = (work, status);
+    }
+    return works;
+  }
+
+  static Future<void> importDanmakuPreference() => _once('danmaku', (_) async {
+        final enabled = await _legacy.invokeMethod<bool>('danmakuVisible');
+        if (enabled != null) {
+          await GStorage.putSettingIfAbsent(SettingsKeys.danmakuEnabledByDefault, enabled);
+        }
+        return true;
+      });
+
+  static Future<void> importFavorites() => _once('favorites', (_) async {
+        final value = await _legacy.invokeMethod<String>('favorites');
+        final rows = jsonDecode(value ?? '[]') as List;
+        if (rows.isEmpty) return false;
+        final repository = CollectCrudRepository();
+        for (final (work, status) in favorites(rows).values.toList().reversed) {
+          if (repository.getCollectible(work.id) == null) {
+            await repository.addCollectible(work, status.value);
+          }
+        }
+        return true;
+      });
+}
