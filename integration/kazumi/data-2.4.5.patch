+++ b/test/anon_legacy_import_test.dart
@@ -0,0 +1,30 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:kazumi/modules/collect/collect_type.dart';
+import 'package:kazumi/services/storage/anon_legacy_import.dart';
+
+void main() {
+  test('skip disabled, incompatible and already installed rules', () {
+    final rules = AnonLegacyImport.pendingRules([
+      {'rule': {'name': 'Existing'}},
+      {'enabled': false, 'rule': {'name': 'Disabled'}},
+      {'rule': {'name': 'Too new', 'api': '9999'}},
+      {'rule': {'name': 'Imported', 'version': '1'}},
+      {'rule': {'name': 'Imported', 'version': '2'}},
+    ], {'existing'});
+    expect(rules.map((p) => p.name), ['Imported']);
+    expect(rules.single.version, '2');
+  });
+
+  test('a confirmed subject ID wins across sources and guessed titles do not migrate', () {
+    final works = AnonLegacyImport.favorites([
+      {'bangumi': 9, 'title': 'Current title', 'status': 'completed'},
+      {'bangumi': 9, 'title': 'Older title', 'status': 'watching'},
+      {'bangumi': 0, 'title': 'Unmatched'},
+      {'bangumi': 1, 'title': 'Before status was added'},
+    ]);
+    expect(works.keys.toList(), [9, 1]);
+    expect(works[9]!.$1.name, 'Current title');
+    expect(works[9]!.$2, CollectType.watched);
+    expect(works[1]!.$2, CollectType.planToWatch);
+  });
+}
