diff --git a/test/anon_rule_aggregate_test.dart b/test/anon_rule_aggregate_test.dart
new file mode 100644
--- /dev/null
+++ b/test/anon_rule_aggregate_test.dart
@@ -0,0 +1,46 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:kazumi/modules/plugin/plugin_http_module.dart';
+import 'package:kazumi/plugins/plugins.dart';
+import 'package:kazumi/plugins/plugins_controller.dart';
+
+class _Catalog extends PluginsController {
+  _Catalog({required super.catalogLoader, required super.pluginLoader,
+      required super.pluginJsonWriter})
+      : super(errorReporter: (_, _, _) {});
+  @override
+  String get ruleRepository => '';
+}
+
+void main() {
+  test('aggregate missing rules while preserving modified local rules', () async {
+    final fetched = <String>[];
+    var writes = 0;
+    final controller = _Catalog(
+      catalogLoader: (_) async => [
+        for (final name in ['EDITED', 'New', 'NEW', 'Broken', 'TooNew'])
+          PluginHTTPItem(name: name, version: '2', useNativePlayer: true, author: '', lastUpdate: 0),
+      ],
+      pluginLoader: (_, name) async {
+        fetched.add(name);
+        if (name == 'Broken') throw Exception('unavailable');
+        return Plugin.fromJson({'name': name, 'api': name == 'TooNew' ? '99999' : '1'});
+      },
+      pluginJsonWriter: (_) async { writes++; },
+    );
+    final edited = Plugin.fromJson({'name': 'edited', 'version': '1', 'userAgent': 'edited by user'});
+    controller.pluginList.add(edited);
+    final ticks = <(int, int)>[];
+    final result = await controller.tryUpdateAllPlugin(installMissing: true,
+        onProgress: (done, total) => ticks.add((done, total)));
+    expect(fetched.toSet(), {'NEW', 'Broken', 'TooNew'});
+    expect(ticks, [(0,3), (1,3), (2,3), (3,3)]);
+    expect([result.updated, result.failed, result.requiresNewerClient, result.notNewer], [1,1,1,1]);
+    expect(writes, 1);
+    expect(controller.pluginList.first, same(edited));
+
+    final retry = await controller.tryUpdateAllPlugin(installMissing: true);
+    expect(retry.notNewer, 2);
+    expect(retry.updated, 0);
+    expect(writes, 1);
+  });
+}
